{
  "manifest_version": 3,
  "name": "Color Vision Mapper",
  "version": "1.1.0",
  "description": "Maps six calibrated color ranges one-way while preserving their paired reference colors.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Color Vision Mapper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
