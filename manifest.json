{
  "manifest_version": 3,
  "name": "Color Vision Mapper",
  "version": "1.2.0",
  "description": "Hardware-accelerated color vision deficiency simulation.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Color Vision Mapper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
